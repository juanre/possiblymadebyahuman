# Production container environment for Render + Neon.
# Copy values to Render's environment variable UI or to local .env.production.
# Do not commit .env.production or real secrets.

# Required: Neon pooled or direct Postgres connection string with TLS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require

# Render provides PORT automatically for web services. Keep 8000 for Docker/local defaults.
PORT=8000

# Required: public HTTPS origin for generated record URLs.
PUBLIC_BASE_URL=https://possiblymadebyahuman.com
NODE_ENV=production
LOG_LEVEL=info

# GHCR image Render should deploy. Prefer an immutable version tag for production.
IMAGE=ghcr.io/OWNER/possiblymadebyahuman:0.1.0

# Neon/serverless-friendly runtime knobs.
PG_POOL_MAX=5
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000
RECORD_BODY_LIMIT_BYTES=10000000

# API admission. Leave a value empty to use the default.
# Global API requests in flight; default is PG_POOL_MAX * 4.
MAX_IN_FLIGHT_API_REQUESTS=
# Per client address: concurrent API requests (default 4), API writes
# (default 600/minute, burst 120), and new uploads, observed sessions or direct
# records (default 30/minute, burst 30). Excess requests receive 429.
MAX_IN_FLIGHT_API_REQUESTS_PER_CLIENT=
RATE_LIMIT_WRITES_PER_MINUTE=
RATE_LIMIT_WRITE_BURST=
RATE_LIMIT_NEW_SESSIONS_PER_MINUTE=
RATE_LIMIT_NEW_SESSION_BURST=
# Required behind Cloudflare -> Render: without it every client shares the
# proxy's address. Set only to a single-address header the trusted proxy sets
# and overwrites; callers can forge any header the proxy passes through.
TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
