{
  "manifest_version": 3,
  "name": "possiblymadebyahuman",
  "version": "__VERSION__",
  "description": "Content-blind writing records for text fields.",
  "action": {
    "default_title": "possiblymadebyahuman",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage",
    "clipboardWrite",
    "alarms",
    "contextMenus",
    "sidePanel",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "commands": {
    "start-writing-record": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Start writing record in focused editor"
    }
  },
  "minimum_chrome_version": "120"
}
